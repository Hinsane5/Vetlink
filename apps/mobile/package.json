{
  "name": "vetlink-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-vector-icons/lucide": "^13.1.4",
    "expo": "~57.0.26",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
