# Nilai ini hanya untuk database PostgreSQL lokal. Bukan kredensial produksi.
NODE_ENV=development
PORT=3000
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vetlink
DATABASE_USER=vetlink
DATABASE_PASSWORD=local-only-not-a-secret
DATABASE_SSL=false
MEDIA_STORAGE_DIR=.local/private-media
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_VIDEO_MAX_BYTES=52428800
